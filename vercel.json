{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/app/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    }
  ],
  "crons": [
    {
      "path": "/api/pipeline/cron",
      "schedule": "0 0 * * *"
    }
  ]
}
