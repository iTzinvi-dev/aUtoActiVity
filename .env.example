# GROQ_API_KEY: Required for Groq LPU AI API calls (groq SDK / llama-3.3-70b-versatile).
# Obtain an API key from https://console.groq.com/keys and configure it in AI Studio Secrets or .env
GROQ_API_KEY="YOUR_GROQ_API_KEY"
GROQ_MODEL="llama-3.3-70b-versatile"

# GITHUB_PAT: GitHub Personal Access Token (classic ghp_... or fine-grained github_pat_... with 'repo' & 'workflow' scope)
# Configure this in the AI Studio Secrets panel to push the codebase & 6h GitHub Actions workflow directly to GitHub.
GITHUB_PAT="YOUR_GITHUB_PAT"
GITHUB_REPO="iTzinvi-dev/aUtonEws"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# TELEGRAM BOT CONFIGURATION
# Obtain TELEGRAM_BOT_TOKEN from @BotFather on Telegram
# Obtain TELEGRAM_CHAT_ID from your target channel (e.g. @my_dev_channel or -1001234567890)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# PIPELINE & DIGEST CONFIGURATION
# Supported values: English, Bengali (keeps technical terms in English)
OUTPUT_LANGUAGE="English"

# Number of top stories to fetch per run
HN_TOP_LIMIT="5"
DEVTO_TOP_LIMIT="5"

# SCHEDULER CONFIGURATION
# Run every N hours (default: 6) or specify a fixed 24h time in HH:MM (e.g. "08:00")
SCHEDULE_INTERVAL_HOURS="6"
DAILY_RUN_TIME=""

# STORAGE & LOGGING PATHS
PROCESSED_IDS_FILE="processed_ids.json"
DAILY_DIGESTS_FILE="daily_digests.json"
PIPELINE_LOG_FILE="pipeline.log"
